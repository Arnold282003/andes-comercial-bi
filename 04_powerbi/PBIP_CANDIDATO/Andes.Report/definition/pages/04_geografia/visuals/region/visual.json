                  "Property": "Region"
                }
              },
              "queryRef": "DimTienda.Region",
              "nativeQueryRef": "Region"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "FactVentas"
                    }
                  },
                  "Property": "Ventas totales"
                }
              },
              "queryRef": "FactVentas.Ventas totales",
              "nativeQueryRef": "Ventas totales"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Ventas por región de la tienda'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
