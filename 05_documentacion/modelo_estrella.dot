digraph Model {
 graph [rankdir=TB, bgcolor="#F4F7FA", pad="0.4", nodesep="0.6", ranksep="0.8", label="ANDES COMERCIAL · Modelo estrella", labelloc=t, fontname="DejaVu Sans", fontsize=22];
